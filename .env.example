# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key

# Email Configuration
USER_EMAIL=your-email@gmail.com
PASSWORD_EMAIL=your-app-password

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# Server Configuration
PORT=3000

# SUNAT API Configuration
SUNAT_API_TOKEN=your-sunat-api-token
# Seguridad
# JWT_SECRET: en producción, al menos 32 caracteres (si no, la API no arranca)
# Duración de la sesión (formato de jsonwebtoken: 8h, 30m…)
JWT_EXPIRES_IN=8h
# Swagger (/api/docs) solo se publica fuera de producción, salvo con true
SWAGGER_PUBLICO=false
